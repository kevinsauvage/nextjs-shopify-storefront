# =============================================================================
# REQUIRED
# =============================================================================
# Validated at server startup by src/config/env.ts.

# Storefront API access token
# Shopify admin: Settings > Apps and sales channels > Develop apps > [App] >
# API credentials > Storefront API access token
SHOPIFY_STORE_FRONT_ACCESS_TOKEN=your_storefront_access_token

# Storefront API GraphQL endpoint
NEXT_PUBLIC_SHOPIFY_STOREFRONT_URL=https://your-store.myshopify.com/api/2026-07/graphql.json

# Canonical site URL (used for metadata, sitemap, robots, cookies)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Durable rate limiting for the contact form (Upstash for Redis).
# Provision via the Upstash integration on Vercel (or `vc i upstash/upstash-kv`).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token


# =============================================================================
# OPTIONAL — Shopify Admin API
# =============================================================================
# Required only for Admin-backed features (wishlist metafields, delegate tokens).
# Set BOTH Admin variables together or omit both.

# Admin API access token
SHOPIFY_STORE_FRONT_ADMIN_TOKEN=your_admin_access_token

# Admin API GraphQL endpoint
SHOPIFY_ADMIN_URL=https://your-store.myshopify.com/admin/api/2026-07/graphql.json

# Delegate token scope (comma-separated)
SHOPIFY_SCOPE=unauthenticated_read_product_listings,unauthenticated_read_product_inventory


# =============================================================================
# OPTIONAL — Site configuration
# =============================================================================

# Cookie domain (without protocol). Defaults to the request host when unset.
NEXT_PUBLIC_SITE_DOMAIN=yourdomain.com

# Google Tag Manager container ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX


# =============================================================================
# OPTIONAL — Error reporting
# =============================================================================
# When set, errors logged via `reportError` are POSTed here as JSON.
ERROR_REPORTING_URL=https://your-error-collector.example.com/ingest


# =============================================================================
# OPTIONAL — Contact form email delivery
# =============================================================================
# Without these the contact form returns a "temporarily unavailable" message.

# Sending mailbox (Gmail) credentials
EMAIL_ADDRESS=yourName@example.com
EMAIL_PASSWORD=your_app_password

# Address that receives contact submissions (defaults to EMAIL_ADDRESS)
CONTACT_EMAIL=contact@yourdomain.com


# =============================================================================
# OPTIONAL — Site metadata (SEO / Open Graph fallbacks)
# =============================================================================
NEXT_PUBLIC_SITE_NAME=Your Company Name
NEXT_PUBLIC_SITE_EMAIL=contact@yourdomain.com
NEXT_PUBLIC_SITE_PHONE=+1 (555) 123-4567
NEXT_PUBLIC_SITE_LOGO=https://yourdomain.com/images/logo.png
NEXT_PUBLIC_SITE_LOGO_SQUARE=https://yourdomain.com/images/logox200.png
NEXT_PUBLIC_SITE_FACEBOOK=https://www.facebook.com/yourpage
NEXT_PUBLIC_SITE_INSTAGRAM=https://www.instagram.com/yourpage
NEXT_PUBLIC_SITE_TWITTER=https://twitter.com/yourpage
NEXT_PUBLIC_SITE_TWITTER_HANDLE=@yourhandle
NEXT_PUBLIC_SITE_LINKEDIN=https://www.linkedin.com/company/yourpage
NEXT_PUBLIC_SITE_ABOUT_SHORT=Your company description here
